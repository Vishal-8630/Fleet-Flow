# Server Environment
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas / Local fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/transport_saas?retryWrites=true&w=majority

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_ORIGIN=http://localhost:5173

# S3 Document Storage (Phase 2)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=transport-saas-documents

# Razorpay Subscriptions (Phase 5)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
