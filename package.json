{
  "name": "fleet-flow",
  "version": "1.0.0",
  "description": "Fleet Flow — Enterprise Multi-Tenant Transport & Fleet Management SaaS",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:phase1": "npm --prefix backend run test:phase1",
    "test:phase2": "npm --prefix backend run test:phase2",
    "test:phase3": "npm --prefix backend run test:phase3",
    "start": "npm --prefix backend run start"
  },
  "keywords": [
    "transport-management",
    "fleet-management",
    "multi-tenant",
    "saas",
    "logistics"
  ],
  "author": "Vishal",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
